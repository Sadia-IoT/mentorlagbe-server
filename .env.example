# ------------------------------------------------------------------
# MentorLagbe server environment
# Copy this file to .env and fill in real values. Never commit .env.
# ------------------------------------------------------------------

# Server
PORT=5000

# Comma separated list of allowed frontend origins (no trailing slash)
# Local:      http://localhost:3000
# Production: https://your-client.vercel.app
CLIENT_URL=http://localhost:3000

# MongoDB Atlas
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
DB_NAME=mentorlagbe

# Stripe (test mode) — Pro Tutor $15 / Pro Student $10
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxx

# Image uploads — used by POST /upload/image (credentials stay on the server)
# Primary: Cloudinary unsigned upload preset (no secret API key needed)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_UPLOAD_PRESET=your-unsigned-preset
# Legacy fallback (only used when the two values above are not set)
IMGBB_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Better Auth JWKS lives on the Next.js app: <CLIENT_URL>/api/auth/jwks
BETTER_AUTH_URL=http://localhost:3000
